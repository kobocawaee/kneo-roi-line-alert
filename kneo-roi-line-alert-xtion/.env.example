# 複製成 .env 再填入：cp .env.example .env
# LINE Developers console > 你的 Messaging API channel > Messaging API 分頁 > Channel access token (long-lived)
LINE_CHANNEL_ACCESS_TOKEN=

# 接收者 ID：個人 userId（U 開頭）或群組 groupId（C 開頭）；多個用逗號分隔
LINE_TO=

# 只有 tools/line_webhook_id.py 用來驗證簽章（Basic settings 分頁的 Channel secret），可留空
LINE_CHANNEL_SECRET=

# 只有 config.yaml 的 alert.attach_image: true 才需要：https://api.imgbb.com/ 登入後取得 API key
IMGBB_API_KEY=
